SERPAPI_KEY=replace_with_your_key
CSV_PATH=data/source_products.csv
# Set the actual currency of your CSV: INR, USD or GBP.
CSV_CURRENCY=
# Must match the CSV currency: in=INR, us=USD, gb=GBP.
API_COUNTRY=in
# Optional: comma-separated terms. Empty uses the first three CSV keywords.
SEARCH_KEYWORDS=
